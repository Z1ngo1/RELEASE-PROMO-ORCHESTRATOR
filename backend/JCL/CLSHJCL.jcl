//CLSHJCL  JOB (ACCT),'ORCH CLASH',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//EXP      EXPORT SYMLIST=*
//*
//* ----------------------------------------------------------------
//* RELEASE & PROMO ORCHESTRATOR -- PHASE 3
//* COMPILE, BIND, AND RUN THE CLSHBAT CLASH-RISK SCORING PROGRAM.
//*
//* STEP STRUCTURE:
//*   CICSPROG - COMPILE CLSHBAT VIA IGYWCL, THE STANDARD BATCH
//*              COBOL+DB2 COMPILE PROCEDURE. CLSHBAT IS A BATCH
//*              PROGRAM
//*   STEP40   - BIND CLSHBAT DBRM INTO PLAN Z73460
//*   STEP50   - RUN CLSHBAT VIA IKJEFT01 (DSN RUN COMMAND)
//*
//* TO RUN ON-DEMAND: SIMPLY SUBMIT THIS JOB.
//* TO RUN NIGHTLY:   SCHEDULE VIA YOUR SITE SCHEDULER POINTING
//*                   AT THE STEP50 STEP ONLY (AFTER INITIAL COMPILE).
//* ----------------------------------------------------------------
//*
// SET MEMBER=CLSHBAT
//*
//* ----------------------------------------------------------------
//* COMPIL - COMPILE COBOL + DB2
//* ----------------------------------------------------------------
//CICSPROG EXEC IGYWCL,PARM.COBOL='SQL,DYNAM,LIB,RENT'
//COBOL.STEPLIB DD DSN=IGY650.SIGYCOMP,DISP=SHR
//              DD DSN=DSND10.DBDG.SDSNEXIT,DISP=SHR
//              DD DSN=DSND10.SDSNLOAD,DISP=SHR
//              DD DSN=CEE.SCEERUN,DISP=SHR
//              DD DSN=CEE.SCEERUN2,DISP=SHR
//COBOL.SYSLIB  DD DSN=Z73460.ORCH.COPYLIB,DISP=SHR
//COBOL.SYSIN   DD DISP=SHR,DSN=Z73460.ORCH.COBOL(&MEMBER)
//COBOL.DBRMLIB DD DISP=SHR,DSN=Z73460.ORCH.DBRMLIB(&MEMBER)
//LKED.SYSLMOD  DD DISP=SHR,DSN=Z73460.CICS.PROD.DFHLOAD
//LKED.SYSIN    DD *,SYMBOLS=EXECSYS
  NAME &MEMBER(R)
/*
//*
//* ----------------------------------------------------------------
//* STEP40 - DB2 BIND
//* ----------------------------------------------------------------
//STEP40  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=DSND10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=EXECSYS
  DSN SYSTEM(DBDG)
  BIND PLAN(Z73460) -
       PKLIST(DSN_DEFAULT_COLLID_Z73460.RELSMGR, -
              DSN_DEFAULT_COLLID_Z73460.PROMGR, -
              DSN_DEFAULT_COLLID_Z73460.EVTMGR, -
              DSN_DEFAULT_COLLID_Z73460.CLASHRDR, -
              DSN_DEFAULT_COLLID_Z73460.CLSHBAT) -
       MEMBER(&MEMBER) -
       LIBRARY('Z73460.ORCH.DBRMLIB') -
       ACTION(REPLACE) -
       ISOLATION(CS) -
       VALIDATE(BIND) -
       QUALIFIER(Z73460)
  END
//SYSIN    DD DUMMY
//*
//* ----------------------------------------------------------------
//* STEP50 - RUN CLSHBAT
//* ----------------------------------------------------------------
//STEP50  EXEC PGM=IKJEFT01,DYNAMNBR=20,
//             COND=(04,LT,STEP40)
//STEPLIB  DD DSN=DSND10.SDSNLOAD,DISP=SHR
//         DD DSN=Z73460.CICS.PROD.DFHLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//CEEDUMP  DD DUMMY
//SYSTSIN  DD *
  DSN SYSTEM(DBDG)
  RUN  PROGRAM(CLSHBAT) PLAN(Z73460) -
       LIB('Z73460.CICS.PROD.DFHLOAD')
  END
//SYSIN    DD DUMMY
//

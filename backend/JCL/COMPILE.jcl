//COMPILE  JOB (ACCT),'ORCH COMPILE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//EXP      EXPORT SYMLIST=*
//*
//* --------------------------------------------------------------------
//* RELEASE & PROMO ORCHESTRATOR -- GENERIC CICS COBOL COMPILE + BIND
//*
//* 1. CHANGE THE VALUE AFTER "SET MEMBER=" BELOW TO THE PROGRAM
//*    YOU WANT TO COMPILE
//*
//* WHAT EACH PART DOES:
//*   CICSPROG - RUNS DFHZITCL, IBM'S STANDARD PROCEDURE THAT DOES
//*              DB2 PRECOMPILE + CICS TRANSLATE + COBOL COMPILE +
//*              LINK-EDIT, ALL IN ONE AUTHORIZED STEP. (CALLING THE
//*              INDIVIDUAL PROGRAMS LIKE DSNHPC DIRECTLY FAILS WITH
//*              A RACF PERMISSION ERROR IN THIS ENVIRONMENT -- THIS
//*              PROCEDURE IS ALREADY AUTHORIZED FOR STUDENT USE.)
//*   STEP40   - TAKES THE DBRM PRODUCED ABOVE AND BINDS IT INTO A
//*              DB2 PACKAGE, SO THE PROGRAM'S SQL STATEMENTS ACTUALLY
//*              WORK WHEN CICS RUNS IT
//* --------------------------------------------------------------------
//*
// SET MEMBER=EVTMGR
//*
//CICSPROG EXEC DFHZITCL,
//            CBLPARM=('NODYNAM,RENT,SQL',
//             'CICS(''COBOL3'')')
//COBOL.STEPLIB DD DSN=DFH620.CICS.SDFHLOAD,DISP=SHR
//              DD DSN=IGY650.SIGYCOMP,DISP=SHR
//              DD DSN=DSND10.DBDG.SDSNEXIT,DISP=SHR
//              DD DSN=DSND10.SDSNLOAD,DISP=SHR
//              DD DSN=CEE.SCEERUN,DISP=SHR
//              DD DSN=CEE.SCEERUN2,DISP=SHR
//COBOL.SYSLIB  DD DSN=DFH620.CICS.SDFHCOB,DISP=SHR
//              DD DSN=DFH620.CICS.SDFHSAMP,DISP=SHR
//              DD DSN=Z73460.ORCH.COPYLIB,DISP=SHR
//COBOL.SYSIN   DD DISP=SHR,DSN=Z73460.ORCH.COBOL(&MEMBER)
//COBOL.DBRMLIB DD DISP=SHR,DSN=Z73460.ORCH.DBRMLIB(&MEMBER)
//LKED.SYSLMOD  DD DISP=SHR,DSN=Z73460.CICS.PROD.DFHLOAD
//LKED.SYSIN    DD *,SYMBOLS=EXECSYS
  NAME &MEMBER(R)
/*
//*
//* ------------------------------------------------------------------
//* STEP40 - DB2 BIND PACKAGE
//* BINDS THE DBRM INTO PACKAGE ORCHCOL.<MEMBER> UNDER COLLECTION
//* ORCHCOL, SO CICS CAN ACTUALLY RUN THIS PROGRAM'S SQL STATEMENTS.
//* ------------------------------------------------------------------
//STEP40  EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=DSND10.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSTSIN  DD *,SYMBOLS=EXECSYS
  DSN SYSTEM(DBDG)
  BIND PLAN(Z73460) -
       PKLIST(DSN_DEFAULT_COLLID_Z73460.RELSMGR, -
              DSN_DEFAULT_COLLID_Z73460.PROMGR, -
              DSN_DEFAULT_COLLID_Z73460.EVTMGR, -
              DSN_DEFAULT_COLLID_Z73460.CLASHRDR, -
              DSN_DEFAULT_COLLID_Z73460.CLSHBAT) -
       MEMBER(&MEMBER) -
       LIBRARY('Z73460.ORCH.DBRMLIB') -
       ACTION(REPLACE) -
       ISOLATION(CS) -
       VALIDATE(BIND) -
       QUALIFIER(Z73460)
  END
//SYSIN    DD DUMMY
//
